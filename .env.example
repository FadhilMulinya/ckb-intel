# External MongoDB Atlas only; URL-encode username/password as needed.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE
CLASSIFIER_SERVICE_URL=http://classifier-service:8000
CLASSIFIER_TIMEOUT_MS=20000
CORS_ALLOWED_ORIGINS=https://demo.afriai.xyz,https://afriai.xyz,https://api.afriai.xyz
ANALYZE_RATE_LIMIT=5
ANALYZE_RATE_WINDOW_SECONDS=60
READ_RATE_LIMIT=60
READ_RATE_WINDOW_SECONDS=60
MAX_CONCURRENT_ANALYSES=2

# Only the immediate host proxy's Docker gateway, never all proxies/Internet.
TRUSTED_PROXY_CIDRS=172.30.0.1/32
DOCKER_SUBNET=172.30.0.0/24
DOCKER_GATEWAY=172.30.0.1

# Existing Dataset V1 file, distributed separately. Must exist before compose up.
FROZEN_SQLITE_PATH=./deployment-data/ckb_explorer.sqlite

# Live network settings; no automatic retry of whole analyses by the registry.
EXPLORER_API_URL=https://mainnet-api.explorer.nervos.org/api/v1
EXPLORER_TIMEOUT_SECONDS=10
EXPLORER_MAX_RETRIES=1
EXPLORER_REQUEST_DELAY_MS=250
EXPLORER_LIVE_PAGE_SIZE=50
