# Mainnet only -- this project's data provenance guarantee requires real
# mainnet data exclusively, so there is no network switch here anymore.

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/behaviour-intelligence

# REST API
API_PORT=3000
API_HOST=0.0.0.0

# Training-data time window: only transactions inside this range are ingested.
# Defaults to the 1-year training window (June 2025 -> end of June 2026).
# INGEST_WINDOW_START=2025-06-01T00:00:00Z
# INGEST_WINDOW_END=2026-06-30T23:59:59.999Z

# Optional overrides (sensible defaults built in)
# EXPLORER_API_URL_MAINNET=https://mainnet-api.explorer.nervos.org/api/v1
# EXPLORER_PAGE_SIZE=50
# REQUEST_DELAY_MS=250
# MAX_TX_PER_WALLET=2000
