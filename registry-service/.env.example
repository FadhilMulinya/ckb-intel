# Running the registry outside Docker; use root .env.example for Compose.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE
API_HOST=127.0.0.1
API_PORT=3000
CLASSIFIER_SERVICE_URL=http://127.0.0.1:8000
CLASSIFIER_TIMEOUT_MS=20000
CORS_ALLOWED_ORIGINS=https://demo.afriai.xyz,https://afriai.xyz
ANALYZE_RATE_LIMIT=5
ANALYZE_RATE_WINDOW_SECONDS=60
READ_RATE_LIMIT=60
READ_RATE_WINDOW_SECONDS=60
# No trusted proxy for direct local development. See README.md production deployment instructions.
TRUSTED_PROXY_CIDRS=
# Set in the classifier process environment, not the registry:
# MAX_CONCURRENT_ANALYSES=2
